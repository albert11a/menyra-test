    { "source": "/:path*", "has": [{ "type": "host", "value": "ceo.mnyra.com" }], "destination": "/apps/menyra-ceo/:path*" },
    { "source": "/", "has": [{ "type": "host", "value": "owner.menyra.com" }], "destination": "/apps/menyra-owner/index.html" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "owner.menyra.com" }], "destination": "/apps/menyra-owner/:path*" },
    { "source": "/", "has": [{ "type": "host", "value": "owner.mnyra.com" }], "destination": "/apps/menyra-owner/index.html" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "owner.mnyra.com" }], "destination": "/apps/menyra-owner/:path*" },
    { "source": "/", "has": [{ "type": "host", "value": "staff.menyra.com" }], "destination": "/apps/menyra-staff/dashboard.html" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "staff.menyra.com" }], "destination": "/apps/menyra-staff/:path*" },
