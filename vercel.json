{
  "redirects": [
    { "source": "/hub", "destination": "/hub/", "permanent": false },
    { "source": "/ceo", "destination": "/ceo/", "permanent": false },
    { "source": "/owner", "destination": "/owner/", "permanent": false },
    { "source": "/staff", "destination": "/staff/", "permanent": false },
    { "source": "/waiter", "destination": "/waiter/", "permanent": false },
    { "source": "/kitchen", "destination": "/kitchen/", "permanent": false },
    { "source": "/social", "destination": "/social/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/", "has": [{ "type": "host", "value": "ceo.menyra.com" }], "destination": "/apps/menyra-social/index.html?tab=leads" },
    { "source": "/", "has": [{ "type": "host", "value": "ceo.mnyra.com" }], "destination": "/apps/menyra-social/index.html?tab=leads" },
    { "source": "/", "has": [{ "type": "host", "value": "owner.menyra.com" }], "destination": "/apps/menyra-social/index.html?tab=profile" },
    { "source": "/", "has": [{ "type": "host", "value": "owner.mnyra.com" }], "destination": "/apps/menyra-social/index.html?tab=profile" },
    { "source": "/", "has": [{ "type": "host", "value": "staff.menyra.com" }], "destination": "/apps/menyra-social/index.html?tab=staff" },
    { "source": "/", "has": [{ "type": "host", "value": "staff.mnyra.com" }], "destination": "/apps/menyra-social/index.html?tab=staff" },
    { "source": "/", "has": [{ "type": "host", "value": "waiter.menyra.com" }], "destination": "/apps/menyra-social/index.html?tab=menu" },
    { "source": "/", "has": [{ "type": "host", "value": "waiter.mnyra.com" }], "destination": "/apps/menyra-social/index.html?tab=menu" },
    { "source": "/", "has": [{ "type": "host", "value": "kitchen.menyra.com" }], "destination": "/apps/menyra-social/index.html?tab=menu" },
    { "source": "/", "has": [{ "type": "host", "value": "kitchen.mnyra.com" }], "destination": "/apps/menyra-social/index.html?tab=menu" },
    { "source": "/hub/", "destination": "/hub/index.html" },
    { "source": "/ceo/", "destination": "/apps/menyra-social/index.html?tab=leads" },
    { "source": "/ceo/:path*", "destination": "/apps/menyra-social/index.html?tab=leads" },
    { "source": "/owner/", "destination": "/apps/menyra-social/index.html?tab=profile" },
    { "source": "/owner/:path*", "destination": "/apps/menyra-social/index.html?tab=profile" },
    { "source": "/staff/", "destination": "/apps/menyra-social/index.html?tab=staff" },
    { "source": "/staff/:path*", "destination": "/apps/menyra-social/index.html?tab=staff" },
    { "source": "/waiter/", "destination": "/apps/menyra-social/index.html?tab=menu" },
    { "source": "/waiter/:path*", "destination": "/apps/menyra-social/index.html?tab=menu" },
    { "source": "/kitchen/", "destination": "/apps/menyra-social/index.html?tab=menu" },
    { "source": "/kitchen/:path*", "destination": "/apps/menyra-social/index.html?tab=menu" },
    { "source": "/apps/menyra-ceo/:path*", "destination": "/apps/menyra-social/index.html?tab=leads" },
    { "source": "/apps/menyra-owner/:path*", "destination": "/apps/menyra-social/index.html?tab=profile" },
    { "source": "/apps/menyra-staff/:path*", "destination": "/apps/menyra-social/index.html?tab=staff" },
    { "source": "/apps/menyra-restaurants/:path*", "destination": "/apps/menyra-social/index.html" },
    { "source": "/testfirst", "destination": "/testfirst.html" },
    { "source": "/testfirst/", "destination": "/testfirst.html" },
    { "source": "/", "destination": "/apps/menyra-social/index.html" },
    { "source": "/social/", "destination": "/apps/menyra-social/index.html" },
    { "source": "/social/:path*", "destination": "/apps/menyra-social/:path*" },
    { "source": "/menyra-restaurants/:path*", "destination": "/apps/menyra-social/index.html" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/social/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/apps/menyra-social/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/apps/menyra-social/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/apps/menyra-social/social-app.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/apps/menyra-social/pwa.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/apps/menyra-social/manifest.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/apps/menyra-social/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/apps/menyra-social/styles/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/hub/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/testfirst.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
