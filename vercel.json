    { "source": "/:path*", "has": [{ "type": "host", "value": "staff.mnyra.com" }], "destination": "/apps/menyra-staff/:path*" },
    { "source": "/", "has": [{ "type": "host", "value": "waiter.menyra.com" }], "destination": "/apps/menyra-restaurants/waiter/index.html" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "waiter.menyra.com" }], "destination": "/apps/menyra-restaurants/waiter/:path*" },
    { "source": "/", "has": [{ "type": "host", "value": "waiter.mnyra.com" }], "destination": "/apps/menyra-restaurants/waiter/index.html" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "waiter.mnyra.com" }], "destination": "/apps/menyra-restaurants/waiter/:path*" },
    { "source": "/", "has": [{ "type": "host", "value": "kitchen.menyra.com" }], "destination": "/apps/menyra-restaurants/kitchen/index.html" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "kitchen.menyra.com" }], "destination": "/apps/menyra-restaurants/kitchen/:path*" },
    { "source": "/", "has": [{ "type": "host", "value": "kitchen.mnyra.com" }], "destination": "/apps/menyra-restaurants/kitchen/index.html" },
    { "source": "/:path*", "has": [{ "type": "host", "value": "kitchen.mnyra.com" }], "destination": "/apps/menyra-restaurants/kitchen/:path*" },
    { "source": "/hub/", "destination": "/hub/index.html" },
    { "source": "/ceo/", "destination": "/apps/menyra-ceo/dashboard.html" },
