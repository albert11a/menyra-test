{
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/local-dev-server.mjs",
    "dev:social": "node scripts/local-dev-server.mjs",
    "dev:local": "node scripts/local-dev-server.mjs",
    "test": "npm run test:unit",
    "test:unit": "node scripts/run-test-files.mjs tests --exclude tests/e2e --exclude tests/rules --exclude tests/functions --exclude tests/mnyra-heart-runner",
    "test:rules": "node scripts/run-test-files.mjs tests/rules",
    "test:functions": "node scripts/run-test-files.mjs tests/functions",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:all": "npm run test:unit && npm run test:rules && npm run test:functions && npm run arch:check && npm run build",
    "lint": "eslint . --quiet",
    "format:check": "prettier --check AGENTS.md docs/codex/**/*.md seed/**/*.json seed/**/*.mjs tests/e2e/**/*.ts tests/rules/**/*.mjs tests/functions/**/*.mjs shared/config/**/*.js scripts/generate-architecture-report.mjs scripts/generate-bundle-report.mjs scripts/run-architecture-check.mjs scripts/run-architecture-graph.mjs scripts/run-architecture-cycles.mjs scripts/run-build-analyze.mjs scripts/run-test-files.mjs scripts/start-local-emulators.mjs .dependency-cruiser.cjs eslint.config.js madge.config.cjs",
    "build": "npm run build:menyra-social:bundle && node scripts/build-vercel-static-output.mjs",
    "build:menyra-social:bundle": "vite build --config vite.config.mjs",
    "build:analyze": "node scripts/run-build-analyze.mjs",
    "bundle:report": "node scripts/generate-bundle-report.mjs",
    "arch:report": "node scripts/generate-architecture-report.mjs",
    "arch:check": "node scripts/run-architecture-check.mjs",
    "arch:graph": "node scripts/run-architecture-graph.mjs",
    "arch:cycles": "node scripts/run-architecture-cycles.mjs",
    "emulators:start": "node scripts/start-local-emulators.mjs",
    "emulators:export": "firebase emulators:export seed/export --project mnyra-local --force",
    "emulators:seed": "node seed/scripts/seed-firestore.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules --project menyra-c0e68",
    "analyze:public-profile-split": "node scripts/analyze-mnyra-public-profile-split.mjs",
    "check:social-bundle": "node scripts/check-mnyra-social-bundle-budget.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.61.1",
    "dependency-cruiser": "^18.0.0",
    "eslint": "^10.6.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions-test": "^3.5.0",
    "firebase-tools": "^15.22.4",
    "madge": "^8.0.0",
    "prettier": "^3.9.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "vite": "7.3.2"
  }
}
