rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function authUid() {
      return signedIn() ? request.auth.uid : "";
    }

    function authEmail() {
      return signedIn() && request.auth.token.email is string ? request.auth.token.email : "";
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function currentUserPath() {
      return userPath(authUid());
    }

    function currentUserExists() {
      return signedIn() && exists(currentUserPath());
    }

    function currentUserData() {
      return currentUserExists() ? get(currentUserPath()).data : {};
    }

    function hasRoleFromData(data, role) {
      return data.role == role || (data.roles is list && role in data.roles);
    }

    function isGlobalCeoUid() {
      return signedIn() && authUid() == "aklBkkIuZ7Nrpx266TJn63rrxX62";
    }

    function isCeoActor() {
      return signedIn() && (
        isGlobalCeoUid()
        || (currentUserExists() && hasRoleFromData(currentUserData(), "ceo"))
        || exists(/databases/$(database)/documents/superadmins/$(authUid()))
      );
    }

    function isSelf(uid) {
      return signedIn() && authUid() == uid;
    }

    function isRestaurantStaffMember(restaurantId) {
      return signedIn()
        && restaurantId is string
        && restaurantId != ""
        && exists(/databases/$(database)/documents/restaurants/$(restaurantId)/staff/$(authUid()));
    }

    function restaurantPath(restaurantId) {
      return /databases/$(database)/documents/restaurants/$(restaurantId);
    }

    function currentRestaurantStaffPath(restaurantId) {
      return /databases/$(database)/documents/restaurants/$(restaurantId)/staff/$(authUid());
    }

    function restaurantExists(restaurantId) {
      return restaurantId is string
        && restaurantId != ""
        && exists(restaurantPath(restaurantId));
    }

    function restaurantData(restaurantId) {
      return restaurantExists(restaurantId) ? get(restaurantPath(restaurantId)).data : {};
    }

    function currentRestaurantStaffExists(restaurantId) {
      return signedIn()
        && restaurantId is string
        && restaurantId != ""
        && exists(currentRestaurantStaffPath(restaurantId));
    }

    function currentRestaurantStaffData(restaurantId) {
      return currentRestaurantStaffExists(restaurantId) ? get(currentRestaurantStaffPath(restaurantId)).data : {};
    }

    function isRestaurantOwner(restaurantId) {
      let data = restaurantData(restaurantId);
      return signedIn() && restaurantExists(restaurantId) && (
        data.ownerUid == authUid()
        || matchesAuthEmail(data)
      );
    }

    function isActiveRestaurantStaffMember(restaurantId) {
      let data = currentRestaurantStaffData(restaurantId);
      return currentRestaurantStaffExists(restaurantId)
        && data.active != false
        && data.status != "disabled";
    }

    function hasRestaurantBusinessAccess(restaurantId) {
      let data = currentRestaurantStaffData(restaurantId);
      return isRestaurantOwner(restaurantId) || (
        isActiveRestaurantStaffMember(restaurantId)
        && (
          data.businessAccess == true
          || (data.permissions is map && data.permissions.businessAccess == true)
        )
      );
    }

    function hasRestaurantWaiterAccess(restaurantId) {
      let data = currentRestaurantStaffData(restaurantId);
      return isRestaurantOwner(restaurantId) || (
        isActiveRestaurantStaffMember(restaurantId)
        && (
          data.waiterAccess == true
          || (data.permissions is map && data.permissions.waiterAccess == true)
        )
      );
    }

    function matchesAuthEmail(data) {
      let email = authEmail();
      return email != "" && (
        data.ownerEmail == email
        || data.email == email
        || data.contactEmail == email
        || data.socialEmail == email
        || data.loginEmail == email
        || data.accountEmail == email
      );
    }

    function ceoPathContainsActor(data) {
      return data.ceoPath is list && authUid() in data.ceoPath;
    }

    function canAccessCeoScopedData(data) {
      return isCeoActor() && (
        isGlobalCeoUid()
        || data.createdByUid == authUid()
        || data.ceoParentUid == authUid()
        || ceoPathContainsActor(data)
      );
    }

    function canAccessCeoRecordData(data) {
      return isCeoActor() && (
        isGlobalCeoUid()
        || data.uid == authUid()
        || data.ceoParentUid == authUid()
        || ceoPathContainsActor(data)
      );
    }

    function canManageRestaurantData(data, restaurantId) {
      return signedIn() && (
        isGlobalCeoUid()
        || data.ownerUid == authUid()
        || data.createdByUid == authUid()
        || data.ceoParentUid == authUid()
        || ceoPathContainsActor(data)
        || matchesAuthEmail(data)
      );
    }

    function canManageRestaurantDoc(restaurantId) {
      return hasRestaurantBusinessAccess(restaurantId) || isCeoActor();
    }

    function canCreateRestaurantDoc(restaurantId) {
      return canManageRestaurantData(request.resource.data, restaurantId) || isCeoActor();
    }

    function canAccessRestaurantOrdersDoc(restaurantId) {
      return hasRestaurantWaiterAccess(restaurantId) || isCeoActor();
    }

    function canManageRestaurantStaffDoc(restaurantId) {
      return isRestaurantOwner(restaurantId) || isCeoActor();
    }

    function staffRestaurantIdFromData(data) {
      return data.staffRestaurantId is string && data.staffRestaurantId != ""
        ? data.staffRestaurantId
        : (
          data.waiterRestaurantId is string && data.waiterRestaurantId != ""
            ? data.waiterRestaurantId
            : (data.restaurantId is string ? data.restaurantId : "")
        );
    }

    function isStaffUserPayload(data) {
      return data.role == "staff"
        || (data.roles is list && "staff" in data.roles)
        || staffRestaurantIdFromData(data) != "";
    }

    function ownerManagedStaffUserAllowedFields() {
      return [
        "uid",
        "displayName",
        "name",
        "firstName",
        "lastName",
        "email",
        "role",
        "roles",
        "staffRole",
        "permissions",
        "businessAccess",
        "waiterAccess",
        "staffActive",
        "staffStatus",
        "status",
        "staffRestaurantId",
        "waiterRestaurantId",
        "restaurantId",
        "businessOwnerUid",
        "createdAt",
        "updatedAt"
      ];
    }

    function ownerManagedStaffUserMutableFields() {
      return [
        "displayName",
        "name",
        "firstName",
        "lastName",
        "role",
        "roles",
        "staffRole",
        "permissions",
        "businessAccess",
        "waiterAccess",
        "staffActive",
        "staffStatus",
        "status",
        "staffRestaurantId",
        "waiterRestaurantId",
        "restaurantId",
        "businessOwnerUid",
        "updatedAt"
      ];
    }

    function validOwnerManagedStaffRole(role) {
      return role == "manager" || role == "waiter";
    }

    function validOwnerManagedStaffPermissions(data) {
      return data.permissions is map
        && data.permissions.keys().hasOnly(["businessAccess", "waiterAccess"])
        && data.businessAccess is bool
        && data.waiterAccess is bool
        && data.permissions.businessAccess == data.businessAccess
        && data.permissions.waiterAccess == data.waiterAccess;
    }

    function validOwnerManagedStaffStatus(data) {
      return data.staffActive is bool
        && data.status is string
        && (
          (data.staffActive == true && data.staffStatus == "active" && data.status == "active")
          || (data.staffActive == false && data.staffStatus == "disabled" && data.status == "disabled")
        );
    }

    function validOwnerManagedStaffIdentity(data, userId, restaurantId) {
      return data.uid == userId
        && data.email is string
        && data.email != ""
        && data.role == "staff"
        && data.roles is list
        && data.roles.size() == 1
        && data.roles[0] == "staff"
        && validOwnerManagedStaffRole(data.staffRole)
        && validOwnerManagedStaffPermissions(data)
        && validOwnerManagedStaffStatus(data)
        && data.staffRestaurantId == restaurantId
        && data.waiterRestaurantId == restaurantId
        && data.businessOwnerUid == authUid()
        && data.restaurantId is string
        && (
          (data.businessAccess == true && data.restaurantId == restaurantId)
          || (data.businessAccess == false && data.restaurantId == "")
        );
    }

    function ownerManagedStaffUserCreateAllowed(userId) {
      let requestedRestaurantId = staffRestaurantIdFromData(request.resource.data);
      return signedIn()
        && authUid() != userId
        && requestedRestaurantId != ""
        && isRestaurantOwner(requestedRestaurantId)
        && request.resource.data.keys().hasOnly(ownerManagedStaffUserAllowedFields())
        && validOwnerManagedStaffIdentity(request.resource.data, userId, requestedRestaurantId);
    }

    function ownerManagedStaffUserUpdateAllowed(userId) {
      let existingRestaurantId = resource != null ? staffRestaurantIdFromData(resource.data) : "";
      return signedIn()
        && resource != null
        && authUid() != userId
        && existingRestaurantId != ""
        && isRestaurantOwner(existingRestaurantId)
        && isStaffUserPayload(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(ownerManagedStaffUserMutableFields())
        && validOwnerManagedStaffIdentity(request.resource.data, userId, existingRestaurantId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && (
          !resource.data.keys().hasAny(["createdAt"])
          || request.resource.data.createdAt == resource.data.createdAt
        );
    }

    function ownerManagedStaffUserDeleteAllowed(userId) {
      let existingRestaurantId = resource != null ? staffRestaurantIdFromData(resource.data) : "";
      return signedIn()
        && authUid() != userId
        && existingRestaurantId != ""
        && isRestaurantOwner(existingRestaurantId)
        && isStaffUserPayload(resource.data);
    }

    function counterOnlyUpdate(allowedFields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields);
    }

    function counterOnlyCreate(allowedFields) {
      return request.resource.data.keys().hasOnly(allowedFields);
    }

    function socialCountersValidOnCreate() {
      return (
        !request.resource.data.keys().hasAny(["likesCount"])
        || request.resource.data.likesCount == 0
      ) && (
        !request.resource.data.keys().hasAny(["commentsCount"])
        || request.resource.data.commentsCount == 0
      );
    }

    function socialCountersUnchanged() {
      return resource != null
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["likesCount", "commentsCount"]);
    }

    function commentCountersValidOnCreate() {
      return !request.resource.data.keys().hasAny(["likesCount"])
        || request.resource.data.likesCount == 0;
    }

    function commentCountersUnchanged() {
      return resource != null
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["likesCount"]);
    }

    function followerCountersValidOnCreate() {
      return (
        !request.resource.data.keys().hasAny(["followersCount"])
        || request.resource.data.followersCount == 0
      ) && (
        !request.resource.data.keys().hasAny(["followingCount"])
        || request.resource.data.followingCount == 0
      );
    }

    function followerCountersUnchanged() {
      return resource != null
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["followersCount", "followingCount"]);
    }

    function protectedUserCountersValidOnCreate() {
      return socialCountersValidOnCreate() && followerCountersValidOnCreate();
    }

    function protectedUserCountersUnchanged() {
      return socialCountersUnchanged() && followerCountersUnchanged();
    }

    function socialCounterUpdateAllowed() {
      return false;
    }

    function followerCounterUpdateAllowed() {
      return false;
    }

    function privilegedUserFields() {
      return [
        "role",
        "roles",
        "ceoParentUid",
        "ceoParentName",
        "ceoRootUid",
        "ceoRootName",
        "ceoPath",
        "crmCounts",
        "businessStatus",
        "businessDeleted",
        "deletedRestaurantId",
        "createdByUid",
        "createdByRole",
        "createdByName",
        "createdByHandle"
      ];
    }

    function privilegedUserFieldsExceptRole() {
      return [
        "roles",
        "ceoParentUid",
        "ceoParentName",
        "ceoRootUid",
        "ceoRootName",
        "ceoPath",
        "crmCounts",
        "businessStatus",
        "businessDeleted",
        "deletedRestaurantId",
        "createdByUid",
        "createdByRole",
        "createdByName",
        "createdByHandle"
      ];
    }

    function safeSelfBootstrapRoleAllowed(data) {
      return !data.keys().hasAny(["role"])
        || data.role == "user"
        || (
          data.role == "business"
          && data.restaurantId is string
          && data.restaurantId != ""
          && isRestaurantOwner(data.restaurantId)
        );
    }

    function safeSelfBootstrapRoleUpdateAllowed() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role"])
        || (
          (!resource.data.keys().hasAny(["role"]) || resource.data.role == "user")
          && safeSelfBootstrapRoleAllowed(request.resource.data)
        );
    }

    function selfUserCreateAllowed(userId) {
      return isSelf(userId)
        && !request.resource.data.keys().hasAny(privilegedUserFieldsExceptRole())
        && safeSelfBootstrapRoleAllowed(request.resource.data)
        && protectedUserCountersValidOnCreate();
    }

    function selfUserUpdateAllowed(userId) {
      return isSelf(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(privilegedUserFieldsExceptRole())
        && safeSelfBootstrapRoleUpdateAllowed()
        && protectedUserCountersUnchanged();
    }

    function ceoManagedUserWriteAllowed(userId) {
      return isCeoActor() && (
        isGlobalCeoUid()
        || isSelf(userId)
        || (resource != null && canAccessCeoScopedData(resource.data))
        || (request.resource.data.ceoPath is list && authUid() in request.resource.data.ceoPath)
        || (
          request.resource.data.businessDeleted == true
          && request.resource.data.businessStatus == "deleted"
          && request.resource.data.deletedRestaurantId is string
        )
      );
    }

    function otherUserCounterWriteAllowed(userId) {
      return signedIn() && authUid() != userId && followerCounterUpdateAllowed();
    }

    function ownerManagedStaffUserReadAllowed(userId) {
      let existingRestaurantId = resource != null ? staffRestaurantIdFromData(resource.data) : "";
      return signedIn()
        && authUid() != userId
        && existingRestaurantId != ""
        && isRestaurantOwner(existingRestaurantId)
        && isStaffUserPayload(resource.data);
    }

    function buyerOwnsOrder() {
      return signedIn()
        && resource.data.buyerUid is string
        && resource.data.buyerUid != ""
        && resource.data.buyerUid == authUid();
    }

    function validOrderCreateForRestaurant(restaurantId) {
      return request.resource.data.restaurantId == restaurantId
        && request.resource.data.keys().hasOnly(orderCreateAllowedFields())
        && validOrderCreateBuyer()
        && validInitialOrderStatus()
        && validOrderItemsForRestaurant(restaurantId)
        && validOrderItemCount()
        && validOrderTotal()
        && (
          !request.resource.data.keys().hasAny(["orderLookupToken", "guestLookupToken"])
          || !signedIn()
        );
    }

    function validOrderCreateBuyer() {
      return (!signedIn() && (!request.resource.data.keys().hasAny(["buyerUid"]) || request.resource.data.buyerUid == ""))
        || (signedIn() && request.resource.data.buyerUid == authUid());
    }

    function orderCreateAllowedFields() {
      return [
        "id",
        "restaurantId",
        "businessName",
        "businessAvatar",
        "buyerUid",
        "buyerName",
        "buyerHandle",
        "buyerAvatar",
        "contact",
        "table",
        "tableNumber",
        "tableLabel",
        "items",
        "itemCount",
        "total",
        "status",
        "orderSource",
        "guestScopeUid",
        "guestSessionId",
        "guestLookupToken",
        "orderLookupToken",
        "createdAt",
        "updatedAt",
        "createdAtClient",
        "updatedAtClient"
      ];
    }

    function orderItemAllowedFields() {
      return [
        "id",
        "itemId",
        "name",
        "price",
        "quantity",
        "imageUrl",
        "category",
        "comment",
        "cartKey",
        "selectedSize",
        "selectedColor",
        "cropX",
        "cropY"
      ];
    }

    function menuItemPath(restaurantId, itemId) {
      return /databases/$(database)/documents/restaurants/$(restaurantId)/menuItems/$(itemId);
    }

    function validInitialOrderStatus() {
      return !request.resource.data.keys().hasAny(["status"])
        || request.resource.data.status == "Neu"
        || request.resource.data.status == "new"
        || request.resource.data.status == "bestellung";
    }

    function validMutableOrderStatus(value) {
      return value == "bestellung"
        || value == "angenommen"
        || value == "fertig"
        || value == "archiv";
    }

    function validOrderItemForRestaurant(restaurantId, item) {
      return item is map
        && item.keys().hasOnly(orderItemAllowedFields())
        && item.itemId is string
        && item.itemId != ""
        && item.name is string
        && item.name != ""
        && item.price is number
        && item.price >= 0
        && item.quantity is number
        && item.quantity >= 1
        && item.quantity <= 99
        && exists(menuItemPath(restaurantId, item.itemId))
        && get(menuItemPath(restaurantId, item.itemId)).data.available != false
        && get(menuItemPath(restaurantId, item.itemId)).data.price == item.price;
    }

    function validOrderItemAt(restaurantId, index) {
      return request.resource.data.items.size() <= index
        || validOrderItemForRestaurant(restaurantId, request.resource.data.items[index]);
    }

    function validOrderItemsForRestaurant(restaurantId) {
      return request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 8
        && validOrderItemAt(restaurantId, 0)
        && validOrderItemAt(restaurantId, 1)
        && validOrderItemAt(restaurantId, 2)
        && validOrderItemAt(restaurantId, 3)
        && validOrderItemAt(restaurantId, 4)
        && validOrderItemAt(restaurantId, 5)
        && validOrderItemAt(restaurantId, 6)
        && validOrderItemAt(restaurantId, 7);
    }

    function orderItemQuantityAt(index) {
      return request.resource.data.items.size() > index ? request.resource.data.items[index].quantity : 0;
    }

    function orderItemTotalAt(index) {
      return request.resource.data.items.size() > index
        ? request.resource.data.items[index].price * request.resource.data.items[index].quantity
        : 0;
    }

    function orderItemQuantitySum() {
      return orderItemQuantityAt(0)
        + orderItemQuantityAt(1)
        + orderItemQuantityAt(2)
        + orderItemQuantityAt(3)
        + orderItemQuantityAt(4)
        + orderItemQuantityAt(5)
        + orderItemQuantityAt(6)
        + orderItemQuantityAt(7);
    }

    function orderItemsTotal() {
      return orderItemTotalAt(0)
        + orderItemTotalAt(1)
        + orderItemTotalAt(2)
        + orderItemTotalAt(3)
        + orderItemTotalAt(4)
        + orderItemTotalAt(5)
        + orderItemTotalAt(6)
        + orderItemTotalAt(7);
    }

    function validOrderItemCount() {
      return request.resource.data.itemCount is number
        && request.resource.data.itemCount == orderItemQuantitySum();
    }

    function validOrderTotal() {
      let expectedTotal = orderItemsTotal();
      return request.resource.data.total is number
        && request.resource.data.total >= expectedTotal - 0.01
        && request.resource.data.total <= expectedTotal + 0.01;
    }

    function orderUpdateAllowedFields() {
      return ["status", "updatedAt", "updatedAtClient"];
    }

    function validOrderStatusUpdateForRestaurant(restaurantId) {
      return canAccessRestaurantOrdersDoc(restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(orderUpdateAllowedFields())
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["status"])
          || validMutableOrderStatus(request.resource.data.status)
        );
    }

    function socialFeedRestaurantIdFromData(data) {
      return data.rid is string && data.rid != ""
        ? data.rid
        : (data.restaurantId is string ? data.restaurantId : "");
    }

    function analyticsEventAllowedFields() {
      return [
        "name", "businessId", "sessionId", "userId", "source",
        "postId", "productId", "productName", "menuId",
        "categoryId", "categoryName", "contactKind", "tableId",
        "orderId", "value", "quantity", "isUnique", "items",
        "day", "hour", "createdAt"
      ];
    }

    function validAnalyticsEventName(name) {
      return name in [
        "business_profile_view", "profile_contact_click",
        "post_impression", "post_click", "post_like", "post_share",
        "menu_open", "category_open", "product_view", "product_like",
        "qr_scan", "call_waiter_click",
        "order_started", "order_completed",
        "feed_impression", "feed_click"
      ];
    }

    function validAnalyticsEventCreate(restaurantId) {
      let data = request.resource.data;
      return data.keys().hasOnly(analyticsEventAllowedFields())
        && data.name is string
        && validAnalyticsEventName(data.name)
        && data.businessId is string
        && data.businessId == restaurantId
        && data.day is string
        && data.day.size() == 10
        && data.hour is number
        && data.hour >= 0
        && data.hour <= 23
        && data.sessionId is string
        && data.sessionId.size() <= 120
        && data.createdAt == request.time
        // Wenn eine userId mitgeschickt wird, muss sie zur Auth-Session gehoeren.
        && (!("userId" in data) || (signedIn() && data.userId == authUid()));
    }

    function analyticsDailyAllowedFields() {
      return [
        "date", "updatedAt", "counters", "uniques", "profileSources",
        "contacts", "hourly", "posts", "products", "categories",
        "tables", "orders"
      ];
    }

    function validAnalyticsDailyWrite(dayId) {
      let data = request.resource.data;
      return data.keys().hasOnly(analyticsDailyAllowedFields())
        && data.date is string
        && data.date == dayId
        && dayId.size() == 10;
    }

    match /users/{userId} {
      allow get, list: if isSelf(userId) || isCeoActor() || ownerManagedStaffUserReadAllowed(userId);
      allow create: if selfUserCreateAllowed(userId) || ceoManagedUserWriteAllowed(userId) || ownerManagedStaffUserCreateAllowed(userId);
      allow update: if selfUserUpdateAllowed(userId) || ceoManagedUserWriteAllowed(userId) || ownerManagedStaffUserUpdateAllowed(userId) || otherUserCounterWriteAllowed(userId);
      allow delete: if isSelf(userId) || ceoManagedUserWriteAllowed(userId) || ownerManagedStaffUserDeleteAllowed(userId);

      match /devices/{deviceId} {
        allow get, list, create, update, delete: if isSelf(userId);
      }

      match /notifications/{notificationId} {
        allow get, list: if isSelf(userId);
        allow create: if false;
        allow update, delete: if isSelf(userId);
      }

      match /followRequests/{requesterUid} {
        allow get: if isSelf(userId) || (signedIn() && requesterUid == authUid());
        allow list: if isSelf(userId);
        allow create: if signedIn()
          && requesterUid == authUid()
          && request.resource.data.requesterUid == authUid()
          && request.resource.data.targetUid == userId;
        allow update, delete: if isSelf(userId) || (signedIn() && requesterUid == authUid());
      }

      match /following/{followId} {
        allow get, list: if isSelf(userId);
        allow create: if isSelf(userId) || (
          signedIn()
          && userId != authUid()
          && request.resource.data.targetType == "user"
          && request.resource.data.targetId == authUid()
          && exists(/databases/$(database)/documents/users/$(authUid())/followRequests/$(userId))
        );
        allow update, delete: if isSelf(userId);
      }

      match /posts/{postId} {
        allow read: if signedIn();
        allow create: if (isSelf(userId) || ceoManagedUserWriteAllowed(userId)) && socialCountersValidOnCreate();
        allow update: if ((isSelf(userId) || ceoManagedUserWriteAllowed(userId)) && socialCountersUnchanged()) || socialCounterUpdateAllowed();
        allow delete: if isSelf(userId) || ceoManagedUserWriteAllowed(userId);

        match /likes/{likeId} {
          allow read: if signedIn();
          allow create, update: if signedIn() && likeId == authUid() && request.resource.data.uid == authUid();
          allow delete: if signedIn() && likeId == authUid();
        }

        match /comments/{commentId} {
          allow read: if signedIn();
          allow create: if signedIn() && request.resource.data.uid == authUid() && commentCountersValidOnCreate();
          allow update: if (signedIn() && resource.data.uid == authUid())
            && commentCountersUnchanged();
          allow delete: if signedIn() && (
            resource.data.uid == authUid()
            || isSelf(userId)
            || ceoManagedUserWriteAllowed(userId)
          );

          match /likes/{likeId} {
            allow read: if signedIn();
            allow create: if signedIn() && likeId == authUid() && request.resource.data.uid == authUid();
            allow update: if false;
            allow delete: if signedIn() && likeId == authUid();
          }
        }
      }

      match /chatThreads/{threadId} {
        allow get, list: if isSelf(userId);
        allow create, update: if isSelf(userId) || (
          signedIn()
          && userId != authUid()
          && threadId == authUid()
          && request.resource.data.uid == authUid()
        );
        allow delete: if isSelf(userId);

        match /messages/{messageId} {
          allow get, list: if isSelf(userId);
          allow create: if (isSelf(userId) && request.resource.data.senderUid == authUid()) || (
            signedIn()
            && userId != authUid()
            && threadId == authUid()
            && request.resource.data.senderUid == authUid()
          );
          allow update: if isSelf(userId) || (
            signedIn()
            && userId != authUid()
            && threadId == authUid()
            && request.resource.data.senderUid == authUid()
          );
          allow delete: if isSelf(userId);
        }
      }

      match /orders/{orderId} {
        allow get, list: if isSelf(userId);
        allow create, update, delete: if false;
      }

      match /menuFavorites/{favoriteId} {
        allow get, list, create, update, delete: if isSelf(userId);
      }
    }

    match /publicRoutes/{slug} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create: if canCreateRestaurantDoc(restaurantId);
      allow update: if ((canManageRestaurantDoc(restaurantId) || isCeoActor()) && followerCountersUnchanged()) || followerCounterUpdateAllowed();
      allow delete: if isCeoActor();

      match /public/{publicDocId} {
        allow read: if true;
        allow create, update, delete: if canManageRestaurantDoc(restaurantId) || isCeoActor();
      }

      match /menuItems/{itemId} {
        allow read: if true;
        allow create, update, delete: if canManageRestaurantDoc(restaurantId) || isCeoActor();
      }

      match /menuSocial/{itemId} {
        allow read: if true;
        allow create: if (canManageRestaurantDoc(restaurantId) || isCeoActor()) && socialCountersValidOnCreate();
        allow update: if ((canManageRestaurantDoc(restaurantId) || isCeoActor()) && socialCountersUnchanged()) || socialCounterUpdateAllowed();
        allow delete: if canManageRestaurantDoc(restaurantId) || isCeoActor();

        match /likes/{likeId} {
          allow read: if true;
          allow create, update: if signedIn() && likeId == authUid() && request.resource.data.uid == authUid();
          allow delete: if signedIn() && likeId == authUid();
        }

        match /comments/{commentId} {
          allow read: if true;
          allow create: if signedIn() && request.resource.data.uid == authUid() && commentCountersValidOnCreate();
          allow update: if (signedIn() && resource.data.uid == authUid())
            && commentCountersUnchanged();
          allow delete: if signedIn() && (
            resource.data.uid == authUid()
            || canManageRestaurantDoc(restaurantId)
            || isCeoActor()
          );

          match /likes/{likeId} {
            allow read: if true;
            allow create: if signedIn() && likeId == authUid() && request.resource.data.uid == authUid();
            allow update: if false;
            allow delete: if signedIn() && likeId == authUid();
          }
        }
      }

      match /socialPosts/{postId} {
        allow read: if true;
        allow create: if (canManageRestaurantDoc(restaurantId) || isCeoActor()) && socialCountersValidOnCreate();
        allow update: if ((canManageRestaurantDoc(restaurantId) || isCeoActor()) && socialCountersUnchanged()) || socialCounterUpdateAllowed();
        allow delete: if canManageRestaurantDoc(restaurantId) || isCeoActor();

        match /likes/{likeId} {
          allow read: if true;
          allow create, update: if signedIn() && likeId == authUid() && request.resource.data.uid == authUid();
          allow delete: if signedIn() && likeId == authUid();
        }

        match /comments/{commentId} {
          allow read: if true;
          allow create: if signedIn() && request.resource.data.uid == authUid() && commentCountersValidOnCreate();
          allow update: if (signedIn() && resource.data.uid == authUid())
            && commentCountersUnchanged();
          allow delete: if signedIn() && (
            resource.data.uid == authUid()
            || canManageRestaurantDoc(restaurantId)
            || isCeoActor()
          );

          match /likes/{likeId} {
            allow read: if true;
            allow create: if signedIn() && likeId == authUid() && request.resource.data.uid == authUid();
            allow update: if false;
            allow delete: if signedIn() && likeId == authUid();
          }
        }
      }

      match /stories/{storyId} {
        allow read: if true;
        allow create, update, delete: if canManageRestaurantDoc(restaurantId) || isCeoActor();
      }

      match /orders/{orderId} {
        allow get: if canAccessRestaurantOrdersDoc(restaurantId) || buyerOwnsOrder();
        allow list: if canAccessRestaurantOrdersDoc(restaurantId);
        allow create: if false;
        allow update: if validOrderStatusUpdateForRestaurant(restaurantId);
        allow delete: if isCeoActor();
      }

      match /orderLookup/{lookupToken} {
        allow get: if true;
        allow list: if canAccessRestaurantOrdersDoc(restaurantId);
        allow create, update, delete: if false;
      }

      match /staff/{staffUid} {
        allow get: if isSelf(staffUid) || canManageRestaurantStaffDoc(restaurantId);
        allow list: if canManageRestaurantStaffDoc(restaurantId);
        allow create, update, delete: if canManageRestaurantStaffDoc(restaurantId);
      }

      // Analytics: Events und Tages-Aggregate.
      // Writes sind bewusst auch fuer Gaeste erlaubt (Tracking im Public-/QR-Flow),
      // aber streng auf Form und erlaubte Felder validiert. Reads sind privat:
      // nur das Business selbst (Owner/Staff mit businessAccess) und der CEO.
      match /analyticsEvents/{eventId} {
        allow get, list: if hasRestaurantBusinessAccess(restaurantId) || isCeoActor();
        allow create: if validAnalyticsEventCreate(restaurantId);
        allow update, delete: if false;
      }

      match /analyticsDaily/{dayId} {
        allow get, list: if hasRestaurantBusinessAccess(restaurantId) || isCeoActor();
        allow create, update: if validAnalyticsDailyWrite(dayId);
        allow delete: if false;
      }
    }

    match /socialFeed/{postId} {
      allow read: if true;
      allow create: if (
        socialFeedRestaurantIdFromData(request.resource.data) != ""
        && (canManageRestaurantDoc(socialFeedRestaurantIdFromData(request.resource.data)) || isCeoActor())
        && socialCountersValidOnCreate()
      );
      allow update: if (
        socialFeedRestaurantIdFromData(request.resource.data) != ""
        && (canManageRestaurantDoc(socialFeedRestaurantIdFromData(request.resource.data)) || isCeoActor())
        && socialCountersUnchanged()
      ) || socialCounterUpdateAllowed();
      allow delete: if (
        socialFeedRestaurantIdFromData(resource.data) != ""
        && (canManageRestaurantDoc(socialFeedRestaurantIdFromData(resource.data)) || isCeoActor())
      );
    }

    match /leads/{leadId} {
      allow read: if canAccessCeoScopedData(resource.data);
      allow create: if canAccessCeoScopedData(request.resource.data);
      allow update: if canAccessCeoScopedData(resource.data) && canAccessCeoScopedData(request.resource.data);
      allow delete: if canAccessCeoScopedData(resource.data);
    }

    // Destination-Templates (Heart -> Orte): Entwuerfe sind CEO-only.
    match /heartDestinations/{destinationId} {
      allow read, write: if isCeoActor();
    }

    // Veroeffentlichte Destination-Projektionen: oeffentlich lesbar, damit
    // Hotel-Detailseiten Template-Orte ohne CEO-Session laden koennen.
    match /destinationsPublic/{destinationId} {
      allow read: if true;
      allow write: if isCeoActor();
    }

    match /superadmins/{uid} {
      allow get: if (isSelf(uid) && isCeoActor()) || canAccessCeoRecordData(resource.data);
      allow list: if canAccessCeoRecordData(resource.data);
      allow create: if (isSelf(uid) && isCeoActor()) || canAccessCeoRecordData(request.resource.data);
      allow update: if ((isSelf(uid) && isCeoActor()) || canAccessCeoRecordData(resource.data))
        && ((isSelf(uid) && isCeoActor()) || canAccessCeoRecordData(request.resource.data));
      allow delete: if (isSelf(uid) && isCeoActor()) || canAccessCeoRecordData(resource.data);
    }

    match /staffAdmins/{uid} {
      allow get: if isSelf(uid) || isCeoActor();
      allow list: if isCeoActor();
      allow create, update, delete: if isCeoActor();
    }

    match /staffIndex/{uid} {
      allow get: if isSelf(uid) || isCeoActor();
      allow list: if isCeoActor();
      allow create, update, delete: if isCeoActor();
    }

    // Collection-Group-Query auf "stories": Der Client laedt Stories per
    // collectionGroup("stories"). Firestore verlangt dafuer eine Regel mit
    // rekursivem Pfad-Wildcard; die verschachtelte restaurants/{rid}/stories-
    // Regel deckt Collection-Group-Queries NICHT ab, weshalb die list-Abfrage
    // sonst auf die Catch-all-Deny faellt ("false for 'list'"). Stories sind
    // ohnehin oeffentlich lesbar (siehe nested rule), daher identische Bedingung.
    match /{path=**}/stories/{storyId} {
      allow read: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

